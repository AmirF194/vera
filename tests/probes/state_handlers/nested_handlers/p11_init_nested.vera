-- P11: a FULL nested handle[State<Nat>] inside the OUTER handle's state INIT
-- expression. The import walker descends only HandleExpr.body, so the Nat
-- family may go unregistered.
-- Nested: init 4, get -> 4*2=8. Outer init = 8+1=9. Expected: 9.
private fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Int>](@Int = nat_to_int(handle[State<Nat>](@Nat = 4) {
    get(@Unit) -> { resume(@Nat.0 + @Nat.0) },
    put(@Nat) -> { resume(()) }
  } in {
    get(())
  }) + 1) {
    get(@Unit) -> { resume(@Int.0) },
    put(@Int) -> { resume(()) }
  } in {
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
