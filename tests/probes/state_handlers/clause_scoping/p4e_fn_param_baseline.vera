-- Baseline: does the checker/wasm alias-arg naming split already affect
-- ordinary fn params (pre-existing), independent of handlers?
type Cnt = Int;

public fn f(@Option<Cnt> -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  match @Option<Int>.0 {
    Some(@Int) -> @Int.0,
    None -> 0 - 1
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  f(Some(5))
}
