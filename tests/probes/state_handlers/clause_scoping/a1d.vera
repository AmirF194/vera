-- A1d: collision at the base name: State<Nat>, @Nat ann, put(@Nat)
public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 100) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) } with @Nat = 2 * @Nat.0 + 3 * @Nat.1
  } in {
    put(5);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
