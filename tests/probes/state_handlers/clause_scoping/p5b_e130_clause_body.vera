-- P5b: clause-body ref past its own bindings with an EMPTY decl scope:
-- get clause scope = [state] only, so @Int.1 dangles -> expect E130.
private fn bad(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Int>](@Int = 0) {
    get(@Unit) -> { resume(@Int.0 + @Int.1) },
    put(@Int) -> { resume(()) }
  } in {
    let @Int = 55;
    put(@Int.0);
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  bad(())
}
