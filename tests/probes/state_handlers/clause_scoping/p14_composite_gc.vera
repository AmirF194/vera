-- P14: composite (heap-pointer) State<Option<Int>> clause under decl_env:
-- allocating clause body + closure; state capture must stay GC-rooted.
-- get clause: state Some(7) -> match binds 7; arr=[7+1,7+2]; resume Some(sum 17).
-- Body: put(Some(50)) -> get -> Some(67)?? recompute: put stores Some(50);
-- get: capture Some(50) -> x=50; arr=[51,52]; resume(Some(103)).
-- main: unwrap -> 103.
private fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = Some(7)) {
    get(@Unit) -> {
      let @Int = match @Option<Int>.0 {
        Some(@Int) -> @Int.0,
        None -> 0
      };
      let @Array<Int> = array_map([1, 2], fn(@Int -> @Int) effects(pure) { @Int.0 + @Int.1 });
      resume(Some(@Array<Int>.0[0] + @Array<Int>.0[1] + @Int.0))
    },
    put(@Option<Int>) -> { resume(()) }
  } in {
    put(Some(50));
    match get(()) {
      Some(@Int) -> @Int.0,
      None -> 0 - 1
    }
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
