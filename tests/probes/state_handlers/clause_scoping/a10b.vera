-- A10b: patternless put, NO outer Nat binding anywhere. If the checker binds
-- no put-arg slot, @Nat.0 in the with-expr must be E130.
type Count = Nat;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Count = 100) {
    get(@Unit) -> { resume(@Count.0) },
    put() -> { resume(()) } with @Count = @Nat.0
  } in {
    put(5);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
