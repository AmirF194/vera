-- A1c: full name collision under the alias: State<Count>, @Count ann, put(@Count)
-- Checker: @Count.0 = state (bound last), @Count.1 = put arg.
type Count = Nat;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 100) {
    get(@Unit) -> { resume(@Count.0) },
    put(@Count) -> { resume(()) } with @Count = 2 * @Count.0 + 3 * @Count.1
  } in {
    put(5);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
