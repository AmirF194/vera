-- Probe 1d: single alias application (the commit's fixed bind case) with an
-- alias-SPELLED ref. Checker: @Option<Cnt>.0 == @Option<Int>.0 = state ->
-- 5. Codegen ref side is syntactic -> expected loud E699 (#1208 class).
type Cnt = Int;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = Some(5)) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Cnt>) -> { resume(()) } with @Option<Int> = @Option<Cnt>.0
  } in {
    put(Some(9));
    option_unwrap_or(get(()), 0 - 1)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
