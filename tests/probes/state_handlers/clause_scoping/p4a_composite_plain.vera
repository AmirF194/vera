-- Angle 4 baseline: composite State<Option<Int>>, no aliases.
public fn probe(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = None) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Int>) -> { resume(()) }
  } in {
    put(Some(@Int.0));
    match get(()) {
      Some(@Int) -> @Int.0,
      None -> 0 - 1
    }
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(41)
}
