-- Probe 5 (control): the commit's fixed mainline. put(@Option<Cnt>) with
-- type Cnt = Int under State<Option<Int>>; body refs the checker-canonical
-- @Option<Int>.1 (the put argument). Expect green and value 9.
type Cnt = Int;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = Some(5)) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Cnt>) -> { resume(()) } with @Option<Int> = @Option<Int>.1
  } in {
    put(Some(9));
    option_unwrap_or(get(()), 0 - 1)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 9)
  effects(pure)
{
  probe(())
}
