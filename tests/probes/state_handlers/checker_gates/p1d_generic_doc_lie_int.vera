private forall<T> fn sneak(@T -> @T)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<T>](@Nat = 3) {
    put(@T) -> { resume(()) }
  } in {
    put(@T.0);
    get(())
  }
}

public fn go(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  sneak(@Int.0)
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  go(0 - 5)
}
