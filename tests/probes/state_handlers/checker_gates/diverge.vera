-- The `with` type and State<T>'s T are not cross-checked: declare the cell as
-- @Int while the effect's T (and the host cell) is Nat.
public fn t(@Int -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Int = @Int.0) {
    get(@Unit) -> { resume(0) }
  } in {
    get(()) < 0
  }
}
public fn main(@Unit -> @Bool) requires(true) ensures(true) effects(pure) { t(0 - 5) }
