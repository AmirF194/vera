public fn f(@Bool -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Byte>](@Byte = 7) {
    get(@Unit) -> { resume(@Byte.0) },
    put(@Byte) -> { resume(()) }
  } in {
    put(if @Bool.0 then { 1 } else { 2 });
    byte_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  f(true)
}
