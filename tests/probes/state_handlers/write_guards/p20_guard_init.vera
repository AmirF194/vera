type Count = Nat;

public fn boot(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = @Int.0) {
    put(@Count) -> { resume(()) }
  } in {
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  boot(0 - 3)
}
