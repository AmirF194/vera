-- The project's own _PUT differential fixture with the put CLAUSE removed.
public fn go(@Int -> @Int) requires(true) ensures(true) effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) }
  } in {
    put(@Int.0);
    nat_to_int(get(()))
  }
}
public fn main(@Unit -> @Int) requires(true) ensures(true) effects(pure) { go(0 - 7) }
