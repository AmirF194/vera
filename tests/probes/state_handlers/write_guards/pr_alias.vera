type Count = Nat;
public fn t(@Int -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 1) {
    get(@Unit) -> { resume(@Count.0) },
    put(@Count) -> { resume(()) }
  } in {
    put(@Int.0);
    get(()) < 0
  }
}
public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  t(0 - 4)
}
