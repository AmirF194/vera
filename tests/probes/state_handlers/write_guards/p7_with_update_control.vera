-- P7 control: `with @Nat = <slot-dependent negative>` -> guard 4 should trap
private fn f(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) } with @Nat = nat_to_int(@Nat.0) - 50
  } in {
    put(5);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  f(())
}
