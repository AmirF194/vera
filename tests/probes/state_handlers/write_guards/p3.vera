-- Probe 3: TIER-3 (untranslatable) put argument into a @Nat state cell.
-- Random.random_int is a QualifiedCall -> SMT returns None -> tier3 fallback,
-- which the #1203 fallback records with guarded=True.
public fn t3(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) }
  } in {
    put(Random.random_int(0 - 9, 0 - 1));
    get(()) < 0
  }
}

public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  t3(())
}
