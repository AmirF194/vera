-- Widen dual must NOT false-trap on an ordinary @Nat value.
public fn t(@Nat -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Int>](@Int = @Nat.0) {
    get(@Unit) -> { resume(@Nat.0) }
  } in {
    get(())
  }
}
public fn main(@Unit -> @Int) requires(true) ensures(true) effects(pure) { t(7) }
