-- `with @Nat = <narrowing>` state-update guard.
public fn t(@Int -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  handle[State<Nat>](@Nat = 1) {
    get(@Unit) -> { resume(@Nat.0) } with @Nat = Random.random_int(0 - 9, 0 - 1)
  } in {
    get(());
    get(()) < 0
  }
}
public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  t(1)
}
