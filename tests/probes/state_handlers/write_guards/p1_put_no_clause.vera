-- P1: put with NO put clause -> bare intrinsic path. Arg contains an
-- effect-op result (opaque to SMT, #1199) minus 100 -> runtime negative.
private fn store(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) }
  } in {
    put(nat_to_int(get(())) - 100);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  store(())
}
