-- Angle 8: #1203 get-resume narrowing guard through an ALIAS cell.
-- The get clause resumes an Int-typed value that is negative at runtime;
-- the Nat bind guard must TRAP (not silently store a negative Nat).
type Count = Nat;

public fn probe(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 5) {
    get(@Unit) -> { resume(@Int.0) },
    put(@Count) -> { resume(()) }
  } in {
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(3)
}
