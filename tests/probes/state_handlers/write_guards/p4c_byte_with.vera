-- P4c: Byte literal at every write boundary: init(1), put-arg(3) via clause
-- dispatch, with-override(200). Expected final get = 200.
private fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Byte>](@Byte = 1) {
    get(@Unit) -> { resume(@Byte.0) },
    put(@Byte) -> { resume(()) } with @Byte = 200
  } in {
    put(3);
    byte_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
