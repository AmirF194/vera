-- P6 control: opaque negative state INIT -> guard 1 should trap
private fn f(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(<State<Nat>>)
{
  handle[State<Nat>](@Nat = nat_to_int(get(())) - 50) {
    get(@Unit) -> { resume(@Nat.0) }
  } in {
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) }
  } in {
    f(())
  }
}
