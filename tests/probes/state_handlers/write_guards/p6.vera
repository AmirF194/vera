-- Probe 6: get-clause resume with a TIER-3 narrowing value.
public fn t6(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(Random.random_int(0 - 9, 0 - 1)) }
  } in {
    get(()) < 0
  }
}

public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  t6(())
}
