-- Probe 12b: obligation-parity twin — identical program with the cell
-- spelled State<Id<Nat>>. Obligation stream must match 12a.
type Id<T> = T;

public fn probe(@Int -> @Int)
  requires(@Int.0 > 0 - 100)
  ensures(true)
  effects(pure)
{
  handle[State<Id<Nat>>](@Id<Nat> = 0) {
    get(@Unit) -> { resume(@Id<Nat>.0) },
    put(@Id<Nat>) -> { resume(()) }
  } in {
    let @Nat = @Int.0;
    put(@Nat.0);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(7)
}
