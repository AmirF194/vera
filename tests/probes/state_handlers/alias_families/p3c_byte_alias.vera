type Level = Byte;

public fn use_level(@Byte -> @Byte)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Level>](@Level = 0) {
    put(@Level) -> { resume(()) }
  } in {
    put(@Byte.0);
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  byte_to_int(use_level(42))
}
