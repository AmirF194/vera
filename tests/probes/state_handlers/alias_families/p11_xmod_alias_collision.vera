-- Probe 11 (angle 4 collision): main declares Hid<T> = Option<T> — the SAME
-- NAME as xmod_lib's private Hid<T> = T. The module fn's family must still
-- collapse via the MODULE's table (Nat), not main's (Option<Nat> — opaque
-- composite). main's own handler uses its Hid meaning Option<Nat>.
import xmod_lib;

type Hid<T> = Option<T>;

public fn local_probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Hid<Int>>](@Hid<Int> = Some(5)) {
    get(@Unit) -> { resume(@Hid<Int>.0) },
    put(@Hid<Int>) -> { resume(()) }
  } in {
    put(Some(9));
    option_unwrap_or(get(()), 0 - 1)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 16)
  effects(pure)
{
  tally(7) + local_probe(())
}
