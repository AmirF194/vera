-- Probe 3b: mutual parameterised alias cycle.
type A<T> = B<T>;
type B<T> = A<T>;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<A<Int>>](@A<Int> = 0) {
    get(@Unit) -> { resume(@A<Int>.0) },
    put(@A<Int>) -> { resume(()) }
  } in {
    put(3);
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
