-- Exn<E> where E is an alias of String (pair type; NOT scalar-collapsed).
-- family = "Msg" -> _is_pair_type_name("Msg")? If pair-ness is lost the
-- caught (ptr,len) desyncs.
type Msg = String;

private fn boom(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(<Exn<Msg>>)
{
  throw("abc")
}

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[Exn<Msg>] {
    throw(@Msg) -> { string_length(@Msg.0) }
  } in {
    boom(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
