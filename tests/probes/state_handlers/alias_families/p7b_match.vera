-- Angle 7: get(()) as match scrutinee under an ALIAS cell (int patterns).
type Count = Nat;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 2) {
    get(@Unit) -> { resume(@Count.0) },
    put(@Count) -> { resume(()) }
  } in {
    match get(()) {
      2 -> 222,
      _ -> 0 - 1
    }
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
