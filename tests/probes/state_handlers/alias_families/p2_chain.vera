type B = Nat;
type A = B;

public fn tally(@Nat -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<A>](@A = 0) {
    get(@Unit) -> { resume(@A.0) },
    put(@A) -> { resume(()) }
  } in {
    put(@Nat.0);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  tally(9)
}
