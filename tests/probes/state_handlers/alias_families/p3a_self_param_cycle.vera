-- Probe 3a: parameterised self-referential alias. Does the checker reject
-- (E132-family)? If check-green, does codegen hang/crash
-- (_type_expr_to_wasm_type has no seen-set)?
type Loop<T> = Loop<T>;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Loop<Int>>](@Loop<Int> = 0) {
    get(@Unit) -> { resume(@Loop<Int>.0) },
    put(@Loop<Int>) -> { resume(()) }
  } in {
    put(3);
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
