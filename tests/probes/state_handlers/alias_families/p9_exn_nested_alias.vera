-- Probe 9: the Exn twin of p2b. Exn<Id<Id<Int>>> — the tag family name
-- resolves through the same seen-set walk. Checker resolves payload to Int.
type Id<T> = T;

private fn thrower(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(<Exn<Id<Id<Int>>>>)
{
  if @Int.0 == 0 then {
    throw(0 - 1)
  } else {
    @Int.0
  }
}

public fn probe(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[Exn<Id<Id<Int>>>] {
    throw(@Id<Int>) -> { @Id<Int>.0 }
  } in {
    thrower(@Int.0)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(0) + probe(42)
}
