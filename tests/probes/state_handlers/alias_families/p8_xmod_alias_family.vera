-- Probe 8 (angle 4): module declares a private parameterised alias and a fn
-- whose handler is State<Hid<Nat>>; the importer calls it. Registration
-- (main-scan) and lowering (per-module alias swap) must agree the family
-- collapses to Nat.
import xmod_lib;

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 7)
  effects(pure)
{
  tally(7)
}
