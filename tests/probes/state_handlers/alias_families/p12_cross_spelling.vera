type Count = Nat;

public fn add_twice(@Nat -> @Unit)
  requires(true)
  ensures(true)
  effects(<State<Count>>)
{
  let @Nat = get(());
  put(@Nat.0 + @Nat.1);
  put(get(()) + @Nat.1)
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 10) {
    put(@Nat) -> { resume(()) }
  } in {
    add_twice(7);
    nat_to_int(get(()))
  }
}
