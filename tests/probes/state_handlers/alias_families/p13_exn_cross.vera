type Code = Int;

public fn risky(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(<Exn<Code>>)
{
  if @Int.0 < 0 then {
    throw(@Int.0)
  } else {
    @Int.0
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[Exn<Int>] {
    throw(@Int) -> { 0 - @Int.0 }
  } in {
    risky(0 - 9)
  }
}
