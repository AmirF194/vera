-- Probe 7 (angle 5): FnType-bodied alias as the State type argument —
-- resolve_alias_type_expr returns None; _family_name falls back to the
-- opaque name. What do check/compile do?
type F = fn(Int -> Int) effects(pure);

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<F>](@F = fn(@Int -> @Int) effects(pure) { @Int.0 + 1 }) {
    get(@Unit) -> { resume(@F.0) },
    put(@F) -> { resume(()) }
  } in {
    apply_fn(get(()), 41)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
