type Flag = Bool;
type Level = Byte;
type Ratio = Float64;

public fn use_flag(@Bool -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Flag>](@Flag = false) {
    put(@Flag) -> { resume(()) }
  } in {
    put(@Bool.0);
    get(())
  }
}

public fn use_ratio(@Float64 -> @Float64)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Ratio>](@Ratio = 0.0) {
    get(@Unit) -> { resume(@Ratio.0) }
  } in {
    put(@Float64.0);
    get(())
  }
}

public fn use_level(@Byte -> @Byte)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Level>](@Level = 0) {
    put(@Level) -> { resume(()) }
  } in {
    put(@Byte.0);
    get(())
  }
}

public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  if use_flag(true) then {
    (use_ratio(2.5) == 2.5) && (byte_to_int(use_level(42)) == 42)
  } else {
    false
  }
}
