-- Probe 2: State<Id<Id<Nat>>> with type Id<T> = T. The checker resolves the
-- cell to Nat. resolve_alias_type_expr's seen-set fires on the second Id
-- (head re-entry after substitution) -> family name stays opaque
-- "Id<Id<Nat>>", while _type_expr_to_wasm_type recurses fully -> i64.
-- Expect: check green; run either invalid WASM or wrong family.
type Id<T> = T;

public fn probe(@Nat -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Id<Id<Nat>>>](@Id<Id<Nat>> = 0) {
    get(@Unit) -> { resume(@Id<Id<Nat>>.0) },
    put(@Id<Id<Nat>>) -> { resume(()) }
  } in {
    put(@Nat.0);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 7)
  effects(pure)
{
  probe(7)
}
