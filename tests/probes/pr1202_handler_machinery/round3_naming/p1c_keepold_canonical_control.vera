-- Probe 1c (control): canonical spellings only. with @Option<Int> =
-- @Option<Int>.0 must be keep-old semantics (state slot) -> output 5.
-- Pins the checker/runtime meaning of index 0 that p1b's spelling maps to.
public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = Some(5)) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Int>) -> { resume(()) } with @Option<Int> = @Option<Int>.0
  } in {
    put(Some(9));
    option_unwrap_or(get(()), 0 - 1)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
