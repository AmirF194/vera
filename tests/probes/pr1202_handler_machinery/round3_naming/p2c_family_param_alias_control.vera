-- Probe 2 control: State<Id<Nat>> (single application) — the commit's own
-- headline fixed case. Must check green and run to 7.
type Id<T> = T;

public fn probe(@Nat -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Id<Nat>>](@Id<Nat> = 0) {
    get(@Unit) -> { resume(@Id<Nat>.0) },
    put(@Id<Nat>) -> { resume(()) }
  } in {
    put(@Nat.0);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 7)
  effects(pure)
{
  probe(7)
}
