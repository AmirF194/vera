import statelib(bump);

type Count = Int;

public fn local_sum(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 0 - 5) {
    get(@Unit) -> { resume(@Count.0) }
  } in {
    put(@Int.0);
    get(())
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  bump(4) + local_sum(0 - 3)
}
