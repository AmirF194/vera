-- Probe 4: SAME as p3 but the handler DECLARES a put clause, so the #1203
-- clause-inlined guard applies.  Differential against p3.
public fn t4(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) }
  } in {
    put(Random.random_int(0 - 9, 0 - 1));
    get(()) < 0
  }
}

public fn main(@Unit -> @Bool)
  requires(true)
  ensures(true)
  effects(<Random>)
{
  t4(())
}
