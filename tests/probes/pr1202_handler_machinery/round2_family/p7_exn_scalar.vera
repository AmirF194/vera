type Code = Int;

public fn risky(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(<Exn<Code>>)
{
  if @Int.0 < 0 then {
    throw(@Int.0)
  } else {
    @Int.0 * 2
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[Exn<Code>] {
    throw(@Code) -> { 0 - @Code.0 }
  } in {
    risky(0 - 41)
  }
}
