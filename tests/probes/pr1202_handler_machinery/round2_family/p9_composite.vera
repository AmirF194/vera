type MaybeInt = Option<Int>;

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<MaybeInt>](@MaybeInt = None) {
    put(@MaybeInt) -> { resume(()) }
  } in {
    put(Some(41));
    match get(()) {
      Some(@Int) -> @Int.0 + 1,
      None -> 0
    }
  }
}
