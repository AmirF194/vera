-- P5 control: get-clause resume with an Int value that is negative at
-- runtime; opaque to SMT via nested get. Guard should trap.
private fn f(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(<State<Nat>>)
{
  handle[State<Nat>](@Nat = 3) {
    get(@Unit) -> { resume(nat_to_int(@Nat.0) - 50) }
  } in {
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) }
  } in {
    f(())
  }
}
