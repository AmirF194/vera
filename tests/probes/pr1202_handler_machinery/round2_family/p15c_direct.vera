

public forall<T> fn pick(@Array<T>, @T -> @T)
  requires(true)
  ensures(true)
  effects(pure)
{
  @T.0
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Nat>](@Nat = 2) {
    put(@Nat) -> { resume(()) }
  } in {
    put(6);
    nat_to_int(pick([get(()), 4], 9))
  }
}
