public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Array<Int>>](@Array<Int> = [1]) {
    get(@Unit) -> { resume(@Array<Int>.0) },
    put(@Array<Int>) -> { resume(()) }
  } in {
    put([5, 6]);
    let @Array<Int> = get(());
    @Array<Int>.0[0]
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
