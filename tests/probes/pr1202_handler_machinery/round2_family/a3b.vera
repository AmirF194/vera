-- A3 alias: keep-old-state with the alias annotation name
type Count = Nat;

public fn probe(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 100) {
    get(@Unit) -> { resume(@Count.0) },
    put(@Count) -> { resume(()) } with @Count = @Count.0
  } in {
    put(5);
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  probe(())
}
