type Count = Nat;

public fn store(@Int -> @Int)
  requires(true)
  ensures(true)
  effects(<State<Count>>)
{
  put(@Int.0);
  nat_to_int(get(()))
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Count>](@Count = 0) {
    get(@Unit) -> { resume(@Count.0) }
  } in {
    store(0 - 5)
  }
}
