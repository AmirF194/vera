type Small = { @Nat | @Nat.0 < 10 };
type Small2 = { @Nat | (@Nat.0 < 10) };

private fn t(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Small>](@Small2 = 5) {
    put(@Small) -> { resume(()) }
  } in {
    nat_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  t(())
}
