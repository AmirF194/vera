type Tiny = { @Byte | @Byte.0 < 10 };

public fn f(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Tiny>](@Tiny = 200) {
    get(@Unit) -> { resume(@Tiny.0) },
    put(@Tiny) -> { resume(()) }
  } in {
    byte_to_int(get(()))
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  f(())
}
