-- Conformance: decreases measure must be well-founded (Chapter 5 / 6)
-- Tests: E127 rejection of a Float64 termination measure — halving
-- forever never crosses a floor, so no ordering bounds the recursion
private fn shrink(@Float64 -> @Float64)
  requires(true)
  ensures(true)
  decreases(@Float64.0)
  effects(pure)
{
  if @Float64.0 < 1.0 then {
    @Float64.0
  } else {
    shrink(@Float64.0 / 2.0)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  let @Float64 = shrink(8.0);
  42
}
