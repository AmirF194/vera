module vera.shadowlib;

-- A module-local data type whose name is one the prelude also provides.
-- Spec 8.4.1: the prelude's data types are ordinary public declarations a
-- program names and shadows -- the reserved namespace is the `Vera` prefix
-- alone (E154) -- so this declaration is legal, and it stays legal for as
-- long as nothing in the program demands the prelude's `Json` (#1277).
private data Json {
  JBlob(Int)
}

public fn blob_size(@Int -> @Int)
  requires(true)
  ensures(@Int.result == @Int.0)
  effects(pure)
{
  match JBlob(@Int.0) {
    JBlob(@Int) -> @Int.0
  }
}
