module vera.util;

-- A user-defined function literally named `show` that returns @Int, NOT the
-- String the `Show` ability operation returns.  The checker does not reserve
-- the ability-op names (unlike E151 registry builtins), so this is legal.
public fn show(@Int -> @Int)
  requires(true)
  ensures(@Int.result == @Int.0 + 1)
  effects(pure)
{
  @Int.0 + 1
}

-- A user-defined `hash` returning @String — the opposite mis-width from `show`
-- (the ability op returns @Int / i64; this returns a String / i32_pair).
public fn hash(@Int -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  "n"
}
