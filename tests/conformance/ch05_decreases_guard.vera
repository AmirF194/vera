-- Conformance: runtime termination guard (Chapter 5, Section 5.6.1)
-- Tests: a lexicographic decreases clause on the classical Ackermann
-- function runs to completion under the runtime guard (the Tier-3
-- fallback E525 promises), and an ADT measure orders by structural size
private fn ackermann(@Nat, @Nat -> @Nat)
  requires(true)
  ensures(true)
  decreases(@Nat.1, @Nat.0)
  effects(pure)
{
  if @Nat.1 == 0 then {
    @Nat.0 + 1
  } else {
    if @Nat.0 == 0 then {
      ackermann(@Nat.1 - 1, 1)
    } else {
      ackermann(@Nat.1 - 1, ackermann(@Nat.1, @Nat.0 - 1))
    }
  }
}

private data Chain {
  End,
  Link(Int, Chain)
}

private fn weigh(@Chain -> @Int)
  requires(true)
  ensures(true)
  decreases(@Chain.0)
  effects(pure)
{
  match @Chain.0 {
    End -> 0,
    Link(@Int, @Chain) -> @Int.0 + weigh(@Chain.0)
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  nat_to_int(ackermann(2, 2)) + weigh(Link(30, Link(5, End)))
}
