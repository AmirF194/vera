-- Conformance: a scalar alias and its base name one cell (Chapter 7,
-- Section 7.5).  Tests: a helper declares `<State<Count>>` with
-- `type Count = Nat` while the handler spells `handle[State<Nat>]` — the
-- family resolves, so both sites reach the same host cell across the
-- function boundary and the helper's writes are visible to the handler's
-- reads (#1205/#1209).
type Count = Nat;

private fn bump(@Nat -> @Unit)
  requires(true)
  ensures(true)
  effects(<State<Count>>)
{
  put(@Nat.0)
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 24)
  effects(pure)
{
  handle[State<Nat>](@Nat = 0) {
    get(@Unit) -> { resume(@Nat.0) },
    put(@Nat) -> { resume(()) }
  } in {
    bump(24);
    nat_to_int(get(()))
  }
}
