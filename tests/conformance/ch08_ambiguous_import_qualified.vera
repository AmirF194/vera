-- Conformance: the disambiguated form of the refused program (Chapter 8, #1304)
-- Tests: a local declaration takes every bare call (8.5.2), so importing both
-- dependencies is no longer ambiguous, and each import is still reachable
-- through the module-qualified form (8.5.3).  222 + 111 == 333.
import ch08_ambiguous_import_lib_int;
import ch08_ambiguous_import_lib_bool;

private forall<T> fn pick(@T -> @Int)
  requires(true)
  ensures(@Int.result == 222)
  effects(pure)
{
  222
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 333)
  effects(pure)
{
  pick(true) + ch08_ambiguous_import_lib_int::pick(true)
}
